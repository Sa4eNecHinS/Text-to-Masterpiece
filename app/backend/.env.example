CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
IMAGE_STORAGE_DIR=images

# Global estimated Neurons reserved per UTC day, not exact Cloudflare billing.
# Failed provider attempts also consume the reservation. No automatic refunds.
# Positive finite decimals, at most two fractional digits; each cost <= limit.
AI_DAILY_NEURON_LIMIT=9000
AI_NEURON_COST_FLUX_1_SCHNELL=65
AI_NEURON_COST_FLUX_2_KLEIN_4B=110

# User / guest: one token every 15 seconds, capacity 1.
RATE_LIMIT_USER_CAPACITY=1
RATE_LIMIT_USER_REFILL_SECONDS=15
# IP: refill speed, not a strict sliding-window limit; bursts up to capacity.
RATE_LIMIT_IP_CAPACITY=5
RATE_LIMIT_IP_REFILL_PER_MINUTE=45

DB_DRIVER=postgresql+asyncpg
DB_USER=text_to_masterpiece
DB_PASS=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=text_to_masterpiece

SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
